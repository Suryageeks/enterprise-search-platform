pipeline {
    agent any

    environment {
        SERVICE_DIR = 'apps/query-service'
        IMAGE_NAME = 'query-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        DOCKER_BUILDKIT=1 docker build \
                            --tag "$IMAGE_NAME:$BUILD_NUMBER" \
                            .
                    '''
                }
            }
        }

        stage('Validate Python Code') {
            steps {
                sh '''
                    docker run --rm \
                        --entrypoint python \
                        "$IMAGE_NAME:$BUILD_NUMBER" \
                        -m compileall -q /app/app
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        REMOTE_IMAGE="$DOCKER_USERNAME/$IMAGE_NAME"

                        cleanup_registry() {
                            docker image rm \
                                "$REMOTE_IMAGE:$BUILD_NUMBER" \
                                >/dev/null 2>&1 || true

                            docker logout >/dev/null 2>&1 || true
                        }

                        trap cleanup_registry EXIT

                        echo "$DOCKER_PASSWORD" |
                            docker login \
                                --username "$DOCKER_USERNAME" \
                                --password-stdin

                        docker tag \
                            "$IMAGE_NAME:$BUILD_NUMBER" \
                            "$REMOTE_IMAGE:$BUILD_NUMBER"

                        docker push "$REMOTE_IMAGE:$BUILD_NUMBER"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker image rm "$IMAGE_NAME:$BUILD_NUMBER" || true'
        }

        success {
            echo "Created and pushed Docker image: ${IMAGE_NAME}:${BUILD_NUMBER}"
        }

        failure {
            echo "Build failed. Please check the logs for details."
        }
    }
}
