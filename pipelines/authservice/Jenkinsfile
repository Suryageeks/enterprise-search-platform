pipeline {
    agent any

    environment {
        SERVICE_DIR = 'apps/auth'
        IMAGE_NAME = 'auth-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'chmod +x mvnw'
                    sh './mvnw --batch-mode clean package -DskipTests'
                }
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts(
                    artifacts: "${SERVICE_DIR}/target/*.jar",
                    fingerprint: true
                )
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}

                        REMOTE_IMAGE="${DOCKER_USERNAME}/${IMAGE_NAME}:${BUILD_NUMBER}"

                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${REMOTE_IMAGE}:${BUILD_NUMBER}

                        docker push ${REMOTE_IMAGE}:${BUILD_NUMBER}

                        docker logout
                    '''
                }
            }
        }

        stage('Clean Docker Image') {
            steps {
                sh 'docker rmi ${IMAGE_NAME}:${BUILD_NUMBER} || true'
            }
        }
    }

    post {
        success {
            echo "Created Docker image: ${IMAGE_NAME}:${BUILD_NUMBER}"
        }

        failure {
            echo "Build failed. Please check the logs for details."
        }
    }
}
