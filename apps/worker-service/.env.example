ENV=dev
HOST=0.0.0.0
PORT=8090

REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=log-ingestion
REDIS_CONSUMER_GROUP=worker-service
REDIS_CONSUMER_NAME=worker-1

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_BUCKET_NAME=dev

POSTGRES_DSN=postgresql+asyncpg://admin:admin@localhost:5433/aisearchdb

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents
QDRANT_COLLECTION_ALIAS=documents
QDRANT_VECTOR_DISTANCE=cosine

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_LOG_INDEX=normalized-logs
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

EMBEDDING_MODEL=bert-base-uncased
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

PII_MASKING_ENABLED=true
PII_MODEL_NAME=Isotonic/distilbert_finetuned_ai4privacy_v2
PII_SCORE_THRESHOLD=0.60
PII_MAX_TOKENS=384
PII_STRIDE=32
PII_DEVICE=cpu
